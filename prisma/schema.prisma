generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 核心使用者
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  phone         String?   // 用於黑名單鎖定
  role          Role      @default(USER)

  // 違規與黑名單
  violationCount Int      @default(0)
  isBlacklisted  Boolean  @default(false)

  // 常用收件資訊 (JSON 儲存: { name, phone, storeName, storeId })
  savedShippingInfo Json?

  orders        Order[]
  cart          Cart?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  USER
  ADMIN
}

// 商品
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Int
  stock       Int         // 庫存
  images      String[]    // 圖片 URL 陣列
  isActive    Boolean     @default(true) // 上下架狀態

  orderItems  OrderItem[]
  cartItems   CartItem[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 購物車 (單一購物車設計)
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
}

// 訂單
model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  // 金額計算
  totalAmount     Int           // 商品總額 (不含運費)
  shippingFee     Int           // 運費
  finalAmount     Int           // 應付總額 (全額模式含運費，訂金模式為 80%)

  // 狀態管理
  status          OrderStatus   @default(PENDING_PAYMENT)

  // 付款與物流方式
  paymentMethod   PaymentMethod
  shippingMethod  ShippingMethod // NORMAL (交貨便), DISCOUNT (賣貨便)

  // 匯款回報資訊
  remitName       String?       // 匯款人姓名
  remitAccount    String?       // 帳號後五碼
  remittedAt      DateTime?     // 回報時間

  // 寄件資訊 (Snapshot)
  shippingName    String
  shippingPhone   String
  shippingStore   String        // 門市名稱/代號
  trackingNumber  String?       // 物流單號

  // 管理員備註 (異常標記)
  adminNote       String?

  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  price     Int     // 下單時的單價 (Snapshot)
}

enum OrderStatus {
  PENDING_PAYMENT   // 待匯款 (8hr)
  PENDING_AUDIT     // 已回報，待審核 (審核中)
  CONFIRMED         // 訂單已成立 (已查帳)
  PREPARING         // 準備出貨 (已拋轉物流)
  SHIPPED           // 已出貨
  COMPLETED         // 完成
  CANCELLED         // 取消 (逾時/庫存回補)
}

enum PaymentMethod {
  FULL_PAYMENT      // 全額匯款
  DEPOSIT           // 訂金匯款
}

enum ShippingMethod {
  NORMAL            // 交貨便
  DISCOUNT          // 賣貨便
}
